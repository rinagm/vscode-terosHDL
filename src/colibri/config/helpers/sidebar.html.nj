                <div class="settings-toc-container">
{%- for tp0 in type_declaration %}
                    <div class="settings-toc-entry" id="toc-{{tp0}}">
                        <div class="settings-toc-entry-label" id="btn-{{tp0}}-general">
                            {%- if type_declaration[tp0]["pages"]|length > 1 %}
                            <i class="codicon codicon-chevron-down"></i>
                            {%- endif %}
                            {{type_declaration[tp0]["title"]}}
                        </div>
                        {%- if type_declaration[tp0]["pages"]|length > 1 %}
                        <div class="settings-toc-children" id="children-{{tp0}}">
                        {%- for tp1 in type_declaration[tp0]["pages"] %}
                            {%- if tp1 != "general" %}
                            <div class="settings-toc-child" id="btn-{{tp0}}-{{tp1}}">
                                {{type_declaration[tp0]["pages"][tp1]["title"]}}
                            </div>
                            {%- endif %}
                        {%- endfor %}
                        </div>
                        {%- endif %}
                    </div>
{%- endfor %}
                </div>